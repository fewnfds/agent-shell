{
  "dependencies": [
    "."
  ],
  "graphs": {
    "agent-shell-workflow": "agent_shell.langgraph_dev:workflow_graph"
  },
  "auth": {
    "path": "agent_shell.langgraph_dev:auth",
    "openapi": {
      "securitySchemes": {
        "ManagementBearer": {
          "type": "http",
          "scheme": "bearer"
        },
        "ApiKeyBearer": {
          "type": "http",
          "scheme": "bearer"
        }
      },
      "security": [
        {
          "ManagementBearer": []
        }
      ],
      "paths": {
        "/ok": {
          "get": []
        },
        "/info": {
          "get": []
        },
        "/metrics": {
          "get": []
        }
      }
    },
    "disable_studio_auth": false
  },
  "http": {
    "app": "agent_shell.langgraph_dev:app"
  }
}
