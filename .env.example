# FORMAT REFERENCE ONLY.
# Agent Shell does not load this file or a repository-root .env file.
# Actual secret values are managed in <data-root>/config/agent-shell.env.
# An operation Agent may use these names through a local program, but must
# never print the actual file, value, or Authorization header.
# Non-sensitive settings are stored in <data-root>/config/system.yaml.

# Management API: Authorization: Bearer <value>
# AGENT_SHELL_MANAGEMENT_TOKEN=<management-password>

# OpenAI-compatible /v1 API: Authorization: Bearer <value>
# AGENT_SHELL_API_KEY=<api-key>

# LangSmith tracing
# LANGSMITH_API_KEY=<langsmith-api-key>

# One credential per Model Connection. UUID is uppercase hex without hyphens.
# AGENT_SHELL_MODEL_<32_HEX_CONNECTION_UUID>_API_KEY=<provider-credential>

# One secret env/Header slot per MCP Connection. UUIDs are uppercase hex
# without hyphens. Agent Shell generates and maintains these references.
# AGENT_SHELL_MCP_<32_HEX_CONNECTION_UUID>_<32_HEX_SLOT_UUID>=<mcp-secret>
