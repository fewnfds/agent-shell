{
  "name": "agent-shell-frontend",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "generate:style-baseline": "node scripts/generate-style-baseline.mjs",
    "dev": "npm run generate:style-baseline && vite",
    "build": "npm run generate:style-baseline && vue-tsc --noEmit && vite build",
    "lint": "eslint .",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "ui:check": "node scripts/check-ui-policy.mjs"
  },
  "dependencies": {
    "@adminlte/vue": "0.3.0",
    "@vue-flow/core": "1.48.2",
    "bootstrap": "5.3.8",
    "bootstrap-icons": "1.13.1",
    "vue": "3.5.41",
    "vue-i18n": "11.4.8",
    "vue-router": "5.2.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.10.9",
    "@vitejs/plugin-vue": "6.0.8",
    "@vue/compiler-dom": "3.5.41",
    "@vue/compiler-sfc": "3.5.41",
    "@vue/test-utils": "2.4.11",
    "@vue/tsconfig": "0.9.1",
    "eslint": "10.8.0",
    "eslint-plugin-vue": "10.10.0",
    "jsdom": "29.1.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.66.0",
    "vite": "8.2.1",
    "vitest": "4.1.10",
    "vue-tsc": "3.3.9"
  },
  "overrides": {
    "glob": "13.0.6"
  }
}
