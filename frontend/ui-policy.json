{
  "version": 2,
  "status": "adminlte-single-stack",
  "dependencies": {
    "requiredExact": {
      "@adminlte/vue": "0.3.0",
      "@vue-flow/core": "1.48.2",
      "bootstrap": "5.3.8",
      "bootstrap-icons": "1.13.1",
      "vue": "3.5.41",
      "vue-i18n": "11.4.8",
      "vue-router": "5.2.0"
    },
    "forbidden": [
      "@adminlte/nuxt",
      "@adminlte/vue/plugins",
      "@fullcalendar/core",
      "@fullcalendar/daygrid",
      "@fullcalendar/interaction",
      "apexcharts",
      "element-plus",
      "flatpickr",
      "jsvectormap",
      "nuxt",
      "overlayscrollbars",
      "quill",
      "sortablejs",
      "tabulator-tables",
      "tom-select"
    ]
  },
  "adminLteVue": {
    "cssImportPaths": ["src/main.ts"],
    "controlledImports": {
      "LteAppContent": ["src/components/PageShell.vue"],
      "LteBreadcrumb": ["src/components/PageShell.vue"],
      "LteModal": ["src/components/ModalHost.vue"],
      "LteSidebarNav": ["src/components/AppShell.vue"],
      "LteToast": ["src/components/ToastHost.vue"],
      "provideColorMode": ["src/components/AppShell.vue"]
    }
  },
  "icons": {
    "cssImportPaths": ["src/main.ts"]
  },
  "styles": {
    "globalCssPaths": ["src/styles/management-console.css"],
    "allowScopedSfcStyles": true,
    "inlineStylePaths": [],
    "hardcodedColorsAllowed": false
  }
}
